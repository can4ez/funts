      "source": "original-app",
      "license": "Original authored content"
    },
    {
      "id": "base-dare-1-22",
      "type": "dare",
      "level": 1,
      "text": "Скажи фразу «Ты сегодня отлично выглядишь» голосом кинозлодея.",
